# Copiar este archivo a .env y completar. NUNCA subir .env a git.

# --- Binance Testnet (Fase 1 / pruebas de integracion) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Binance Demo Mode (Fase 2 - datos realistas, fondos virtuales) ---
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# --- Binance REAL (Fase 3 - SOLO cuando el checklist de LIVE_PROMOTION_CHECKLIST.md este 100% aprobado) ---
# La API key de real NUNCA debe tener permiso de retiro (withdrawal).
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# --- Modo activo: testnet | demo | paper | live ---
TRADING_MODE=testnet

# --- Alertas ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Base de datos local ---
DUCKDB_PATH=./data/trading.duckdb
PARQUET_DIR=./data/parquet
